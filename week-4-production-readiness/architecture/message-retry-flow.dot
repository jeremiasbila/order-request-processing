digraph G {
 graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.45", fontname="Arial"];
 node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#475569", fontname="Arial", fontsize=10];
 edge [color="#475569", fontname="Arial", fontsize=9];
 req [label="1. Client submits order"];
 accept [label="2. Producer validates + SendMessage"];
 q [label="3. SQS stores accepted order", shape=cylinder, fillcolor="#FFF7ED"];
 proc [label="4. Consumer receives batch"];
 success [label="5A. Conditional DynamoDB PutItem\nstatus = PROCESSED", fillcolor="#ECFDF5"];
 fail [label="5B. Processing exception\nrecord returned in batchItemFailures", fillcolor="#FEF2F2"];
 vis [label="6. Message becomes visible again\nafter visibility timeout"];
 dlq [label="7. maxReceiveCount = 5\nmove to DLQ", shape=cylinder, fillcolor="#FEF2F2"];
 ops [label="8. CloudWatch alarm + operator investigation\nfix -> controlled redrive", fillcolor="#F5F3FF"];
 dup [label="Duplicate delivery?\nDynamoDB condition makes processing idempotent", shape=diamond, fillcolor="#EFF6FF"];
 req -> accept -> q -> proc -> dup;
 dup -> success [label="first valid processing"];
 dup -> fail [label="error"];
 fail -> vis -> proc [label="retry"];
 fail -> dlq [label="receive threshold reached", color="#DC2626"];
 dlq -> ops;
}